# Copié en .env par make install, lu par Docker Compose (docker-compose.yml). Valeurs de développement local seulement.

# Ports de la machine : interface, API et Postgres
WEB_PORT=3030
API_PORT=4030
POSTGRES_PORT=5435
# Interface web de Mailpit, où l'on lit les e-mails de développement : http://localhost:8025
MAILPIT_PORT=8025

# Envoi des e-mails (rappel de la veille des réservations, chaque jour à 18h00 heure de Paris).
# En développement, make dev démarre Mailpit et l'API lui envoie tout : laisser SMTP_HOST et SMTP_PORT tels quels.
# En production, SMTP_HOST vide désactive les rappels (l'API le signale au démarrage).
SMTP_HOST=mailpit
SMTP_PORT=1025
# true pour un SMTP en TLS direct (port 465) ; false sinon (STARTTLS est négocié si le serveur le propose)
SMTP_SECURE=false
# Identifiants du serveur SMTP, vides sans authentification
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché
SMTP_FROM=La Verrière <reservations@laverriere.local>

# Horloge réglable de l'API, du seed et de l'interface : une date ISO 8601 avec fuseau, par exemple
# 2026-11-05T19:30:00+01:00. L'horloge part de cet instant au démarrage des conteneurs (make up), puis avance.
# Vide : l'heure réelle. Après un changement : make down, make db-seed, make up.
FAKE_NOW=
